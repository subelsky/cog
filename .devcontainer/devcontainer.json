// Synergy raw-data container — the Esper ingestion sandbox.
//
// This file is the security boundary. The mount list below is the whole point:
// untrusted source content is processed here, and the private memory/ tree is
// simply not present to be leaked. Read .devcontainer/README.md before editing.
//
// devcontainer.json is JSONC — comments are part of the format.
{
  "name": "Synergy raw-data (Esper ingestion)",

  "build": {
    // Context is this directory, not the repo root: no repo content enters the image.
    "dockerfile": "Dockerfile",
    "context": "."
  },

  // No features. Every feature is another build-time supply chain in a container
  // whose reason to exist is a small attack surface.
  "features": {},

  // --------------------------------------------------------------------------
  // Filesystem
  // --------------------------------------------------------------------------
  // The default devcontainer behaviour is to bind-mount the whole workspace
  // folder. That would re-introduce memory/ and defeat the design, so the
  // workspace mount is overridden to esper/ alone. /workspaces/Synergy itself
  // comes from the image (container layer, ephemeral, host-invisible) and
  // everything the container may see from the host is listed explicitly.
  //
  // The path is /workspaces/Synergy — matching the devcontainer /workspaces/<repo>
  // convention the personal and work supercontainers use — so a shell lands
  // somewhere predictable. It is NOT the repo root: only the three mounts below
  // are present under it.
  "workspaceMount": "source=${localWorkspaceFolder}/esper,target=/workspaces/Synergy/esper,type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/Synergy",

  "mounts": [
    // Skill definitions, including /integrate. Read-only: a prompt injection in
    // a source file must not be able to rewrite the skill that reads it.
    "source=${localWorkspaceFolder}/.claude/commands,target=/workspaces/Synergy/.claude/commands,type=bind,readonly",

    // The container's own CLAUDE.md, mounted over the project root's. The repo's
    // CLAUDE.md is never mounted — it tells the assistant to read memory/, which
    // does not exist here.
    "source=${localWorkspaceFolder}/.devcontainer/CLAUDE.md,target=/workspaces/Synergy/CLAUDE.md,type=bind,readonly",

    // Isolated Claude config dir (CLAUDE_CONFIG_DIR) — NOT the host's ~/.claude.
    // Named volume so credentials survive a rebuild; blow it away with
    // `docker volume rm synergy-raw-claude-config` to force a fresh login.
    "source=synergy-raw-claude-config,target=/home/vscode/.claude-raw,type=volume",

    // Isolated npm cache — NOT the host's ~/.npm.
    "source=synergy-raw-npm-cache,target=/home/vscode/.npm,type=volume",

    // Shadow the host's esper/.git with an empty tmpfs.
    //
    // The esper bind above is read-write, which means it also exposes esper/.git
    // read-write. That is a container -> host code execution path: a prompt
    // injection can drop an executable esper/.git/hooks/post-checkout (or set
    // core.pager / core.fsmonitor in esper/.git/config), and the next time git
    // runs in ~/Synergy/esper ON THE HOST it executes with full user privileges
    // — outside the container, outside the firewall, next to memory/.
    //
    // The container has no legitimate use for .git: CLAUDE.md forbids committing
    // and pushing, and the host owns git for esper/. Shadowing it costs nothing
    // and closes the path. Ordering is by destination depth, so this lands on
    // top of the esper mount.
    "target=/workspaces/Synergy/esper/.git,type=tmpfs,readonly"

    // ------------------------------------------------------------------------
    // Source mounts — all read-only, all under /sources.
    // (Entries below carry LEADING commas, so the last required mount above
    // must not have a trailing one.)
    //
    // These used to live at esper/raw/*, inside the repo and inside the esper
    // git repo. That put untrusted source content where the HOST Claude session
    // could reach it: the Read(/esper/raw/**) deny in .claude/settings.json
    // covers file tools and Bash path arguments, but not git object access
    // (`git -C esper show HEAD:raw/...` reads the blob with no path to match),
    // and all of it was committed.
    //
    // Same principle as memory/ not being mounted here: absence beats a deny
    // rule. The host repo now holds no untrusted content, so there is nothing to
    // forbid and nothing in git to recover.
    //
    // A bind mount whose host source does not exist makes the container fail to
    // start — keep these in sync with ~/Synergy-Esper-Sources.
    // ------------------------------------------------------------------------
    ,"source=${localEnv:HOME}/Synergy-Esper-Sources/readwise,target=/sources/readwise,type=bind,readonly"
    ,"source=${localEnv:HOME}/Synergy-Esper-Sources/evernote,target=/sources/evernote,type=bind,readonly"
    ,"source=${localEnv:HOME}/Synergy-Esper-Sources/goodreads,target=/sources/goodreads,type=bind,readonly"
    ,"source=${localEnv:HOME}/Synergy-Esper-Sources/instapaper,target=/sources/instapaper,type=bind,readonly"
    ,"source=${localEnv:HOME}/Synergy-Esper-Sources/research_papers,target=/sources/research_papers,type=bind,readonly"

    // Not yet moved — uncomment when these source dirs exist.
    // ,"source=${localEnv:HOME}/Documents/email,target=/sources/email,type=bind,readonly"
    // ,"source=${localEnv:HOME}/.claude/projects,target=/sources/claude-code,type=bind,readonly"

    // If the cog re-baseline moves skills from .claude/commands to .claude/skills,
    // add this mount (and keep or drop the commands one to match the repo):
    // ,"source=${localWorkspaceFolder}/.claude/skills,target=/workspaces/Synergy/.claude/skills,type=bind,readonly"
  ],

  // --------------------------------------------------------------------------
  // Environment
  // --------------------------------------------------------------------------
  "containerEnv": {
    // The /integrate gate. Set ONLY here — not by the personal or work
    // supercontainers — so the skill runs in this sandbox and nowhere else.
    "SYNERGY_RAW": "1",
    "DEVCONTAINER": "true",

    // Isolated config dir. Never the host's ~/.claude.
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude-raw",
    "NPM_CONFIG_CACHE": "/home/vscode/.npm",
    "NPM_CONFIG_PREFIX": "/home/vscode/.npm-global",

    // sentry.io is not on the firewall allowlist; disabling error reporting
    // avoids pointless blocked connections at startup.
    "DISABLE_ERROR_REPORTING": "1",

    "LANG": "en_US.UTF-8",
    "LC_ALL": "en_US.UTF-8",
    "LANGUAGE": "en_US:en"
  },

  // --------------------------------------------------------------------------
  // Network
  // --------------------------------------------------------------------------
  // NET_ADMIN/NET_RAW are what let init-firewall.sh install its own rules inside
  // this container's network namespace. They confer no privilege on the host.
  // --name gives the container a stable, predictable handle, the same way the
  // personal and work supercontainers get one, so `docker exec -it synergy-raw`
  // works without looking up a random Docker name. Rebuild with
  // `devcontainer up --workspace-folder . --remove-existing-container`.
  "runArgs": ["--name", "synergy-raw", "--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],

  // Runs on every start, as vscode, via the single sudoers entry in the
  // Dockerfile. Fails closed: a non-zero exit here means egress is fully denied
  // and the devcontainer reports the failure.
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",

  "remoteUser": "vscode",

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  }
}
