# Containerfile - Apple Container image for Esper ingestion sandbox
#
# Build:  container build -t clean-room .
#

FROM debian:bookworm-slim

ARG DEBIAN_FRONTEND=noninteractive
ARG NODE_VERSION=24
ARG HOST_UID=501
ARG HOST_GID=20
ARG USERNAME=claude

# Install packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    vim \
    ca-certificates \
    git \
    openssh-client \
    build-essential \
    python3 \
    locales \
    jq \
    ripgrep \
    fd-find \
    dnsmasq \
    iptables \
    ipset \
    iputils-ping \
    sudo \
    zsh \
    && rm -rf /var/lib/apt/lists/*

# Locale
RUN sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && locale-gen
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

# Node.js — install curl as a build-only dep, use it to fetch the NodeSource
# setup script, then purge curl so it's not present in the runtime image.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && curl -fsSL https://deb.nodesource.com/setup_${NODE_VERSION}.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get purge -y curl \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# Claude Code
RUN npm install -g @anthropic-ai/claude-code \
    && npm cache clean --force

# Create user
RUN groupadd -g ${HOST_GID} ${USERNAME} 2>/dev/null || true \
    && useradd -m -u ${HOST_UID} -g ${HOST_GID} -s /bin/zsh ${USERNAME}

# Allow claude to run iptables via sudo (no password)
RUN echo "${USERNAME} ALL=(root) NOPASSWD: /usr/sbin/iptables, /usr/sbin/ipset, /usr/sbin/dnsmasq, /usr/bin/tee /etc/resolv.conf" \
    > /etc/sudoers.d/${USERNAME} \
    && chmod 0440 /etc/sudoers.d/${USERNAME}

# Directories for mounts
RUN mkdir -p /workspaces/Synergy /workspaces/Synergy/esper /sources \
    && chown -R ${HOST_UID}:${HOST_GID} /workspaces

# Zsh config — vi mode, colors, prompt
RUN cat > /home/${USERNAME}/.zshrc <<'ZSHEOF'
bindkey -v
export KEYTIMEOUT=1
autoload -U colors && colors
PS1="%{$fg[cyan]%}[esper] %{$fg[green]%}%~ %{$reset_color%}$ "
HISTFILE=~/.zsh_history
HISTSIZE=1000
SAVEHIST=1000
setopt appendhistory hist_ignore_dups
autoload -Uz compinit && compinit
alias ls='ls --color=auto'
alias ll='ls -la --color=auto'
alias grep='grep --color=auto'
ZSHEOF
RUN chown ${HOST_UID}:${HOST_GID} /home/${USERNAME}/.zshrc

# Env vars that persist into shell
RUN cat > /home/${USERNAME}/.zshenv <<'ENVEOF'
export DEVCONTAINER=true
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export EDITOR=vim
export VISUAL=vim
export COLORTERM=truecolor
export SHELL=/bin/zsh
export TERM=${TERM:-xterm-256color}
export PATH="$HOME/.local/bin:$PATH"
ENVEOF
RUN chown ${HOST_UID}:${HOST_GID} /home/${USERNAME}/.zshenv

# Gitconfig from host (Apple Container can't bind-mount single files)
COPY --chown=${HOST_UID}:${HOST_GID} .gitconfig-host /home/${USERNAME}/.gitconfig

# Entrypoint — runs AS claude user, uses sudo for iptables
COPY --chown=${HOST_UID}:${HOST_GID} entrypoint.sh /home/${USERNAME}/entrypoint.sh
RUN chmod +x /home/${USERNAME}/entrypoint.sh

# Git trust
RUN git config --global --add safe.directory /workspaces/Synergy

# Run as claude user (no user switching needed = no signal problems)
USER ${USERNAME}
WORKDIR /workspaces/Synergy

ENTRYPOINT ["/home/claude/entrypoint.sh"]
CMD []
